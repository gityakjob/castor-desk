{
  "name": "castor-desk",
  "version": "1.0.0",
  "description": "Castor Desk — Unofficial open-source Linux desktop wrapper for Google Gemini on CachyOS / Arch Linux",
  "main": "app/main.js",
  "repository": {
    "type": "git",
