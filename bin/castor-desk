#!/bin/bash
set -e

# Configuration files
FLAGS_FILE="${XDG_CONFIG_HOME:-${HOME}/.config}/castor-desk-flags.conf"
CARRIAGE_RETURN="$(printf '\r')"

# Default Wayland flags if running on Wayland
WAYLAND_FLAGS=()
if [ "$XDG_SESSION_TYPE" = "wayland" ] || [ -n "$WAYLAND_DISPLAY" ]; then
    WAYLAND_FLAGS=(
        "--ozone-platform-hint=auto"
        "--enable-features=WaylandWindowDecorations"
    )
fi

# Locate Electron binary
ELECTRON_BIN=""
if command -v electron38 >/dev/null 2>&1; then
    ELECTRON_BIN="$(command -v electron38)"
elif command -v electron >/dev/null 2>&1; then
    ELECTRON_BIN="$(command -v electron)"
else
    echo "Error: Electron no encontrado. Por favor instala electron con: sudo pacman -S electron38" >&2
    exit 1
fi

# Locate Application Directory dynamically
APP_DIR=""
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

if [ -f "$SCRIPT_DIR/../app/main.js" ]; then
    APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
elif [ -d "${XDG_DATA_HOME:-${HOME}/.local/share}/castor-desk/app" ]; then
    APP_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/castor-desk"
elif [ -d "/usr/share/castor-desk/app" ]; then
    APP_DIR="/usr/share/castor-desk"
elif [ -d "/usr/lib/castor-desk/app" ]; then
    APP_DIR="/usr/lib/castor-desk"
fi

if [ -z "$APP_DIR" ]; then
    echo "Error: Directorio de aplicación no encontrado." >&2
    exit 1
fi

# Collect user flags from ~/.config/castor-desk-flags.conf
USER_FLAGS=()
if [ -r "${FLAGS_FILE}" ]; then
    while IFS= read -r flag || [ -n "${flag}" ]; do
        flag=${flag%"${CARRIAGE_RETURN}"}
        leading_space=${flag%%[![:space:]]*}
        flag=${flag#"${leading_space}"}
        trailing_space=${flag##*[![:space:]]}
        flag=${flag%"${trailing_space}"}

        case ${flag} in
            ''|'#'*) continue ;;
        esac

        USER_FLAGS+=("${flag}")
    done < "${FLAGS_FILE}"
fi

# Execute Electron standalone app with all flags and arguments
exec "$ELECTRON_BIN" \
    "${WAYLAND_FLAGS[@]}" \
    "${USER_FLAGS[@]}" \
    "$APP_DIR" \
    "$@"
